---
/**
 * AppShell.astro — top-level layout for every Open Review page.
 *
 * Render order (bottom → top):
 *   z-0  .atmos     two slow violet drifts
 *   z-1  .stars     curated celestial atlas, 23 points
 *   z-2  .grain     fractal-noise paper texture
 *   z-3  .vignette  edge fade
 *   z-4  .scanline  horizontal banding (desktop only)
 *   z-10 .shell     content (header + slot + colophon)
 *
 * Fonts (D10): Cormorant Garamond + Inter + JetBrains Mono via Google
 * Fonts CDN. Self-hosting woff2 is a Step 6 polish task (R17).
 */
import '@styles/global.css';
import { SITE } from '@data/site';
import Colophon from '@components/Colophon.astro';
import EditionStamp from '@components/EditionStamp.astro';

interface Props {
  title?: string;
  description?: string;
  showAttribution?: boolean;
  /** Show the edition stamp in the masthead. Defaults true; set false on
   *  pages that are themselves about the edition (the about page, etc.) */
  showStamp?: boolean;
  /** Page-level OG image override. */
  ogImage?: string;
  /** Body class hook for per-page styling. */
  bodyClass?: string;
}

const {
  title       = SITE.title,
  description = SITE.tagline,
  showAttribution = true,
  showStamp   = true,
  ogImage     = `${SITE.baseUrl}/og-${SITE.edition}.png`,
  bodyClass   = '',
} = Astro.props;

const fullTitle = title === SITE.title ? title : `${title} — ${SITE.title}`;
const canonical = `${SITE.baseUrl}${Astro.url.pathname}`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0d0a18" />
    <meta name="referrer"    content="no-referrer" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonical} />
    <meta property="og:title"       content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImage} />
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><circle cx='16' cy='16' r='13' fill='none' stroke='%23a78bfa' stroke-width='1.4'/><circle cx='16' cy='16' r='3' fill='%23a78bfa'/></svg>" />

    <!-- Fonts: Cormorant Garamond + Inter + JetBrains Mono. Self-hosted in Step 6 (R17). -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500;1,600&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>

  <body class={bodyClass}>
    <div class="atmos"    aria-hidden="true"></div>
    <div class="stars"    aria-hidden="true"></div>
    <div class="grain"    aria-hidden="true"></div>
    <div class="vignette" aria-hidden="true"></div>
    <div class="scanline" aria-hidden="true"></div>

    <div class="shell">
      <header class="masthead reveal" style="--reveal-delay: 0s">
        <a class="brand" href="/" aria-label="Pyragogy Open Review home">
          <img
            src="/logo-pyragogy.svg"
            alt="Pyragogy"
            class="brand-logo"
            width="220"
            height="40"
          />
          <span class="brand-tagline">
            <span class="brand-sep" aria-hidden="true">·</span>
            <em class="display-soft">Open Review</em>
          </span>
        </a>

        <div class="masthead-right">
          <span class="edition-text">
            <span class="edition-label">Annual Edition</span>
            <span class="edition-num display-soft">{SITE.edition}</span>
          </span>
          {showStamp && (
            <span class="stamp-wrap"><EditionStamp size={56} /></span>
          )}
        </div>
      </header>

      <main id="main">
        <slot />
      </main>

      <Colophon attribution={showAttribution} />
    </div>
  </body>
</html>

<style>
  .masthead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.4rem clamp(1.5rem, 4vw, 3rem);
    border-bottom: 1px solid var(--rule);
    position: relative;
  }

  /* Decorative under-rule — a thin violet hairline beneath the main rule */
  .masthead::after {
    content: '';
    position: absolute;
    left: clamp(1.5rem, 4vw, 3rem);
    right: clamp(1.5rem, 4vw, 3rem);
    bottom: -3px;
    height: 1px;
    background: linear-gradient(
      to right,
      transparent 0%,
      var(--rule-violet) 14%,
      var(--rule-violet) 86%,
      transparent 100%
    );
    opacity: 0.6;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    text-decoration: none;
    color: var(--paper-fade);
    transition: opacity 0.2s;
  }
  .brand:hover { opacity: 0.85; }

  .brand-logo {
    height: 26px;
    width: auto;
    display: block;
    flex-shrink: 0;
  }

  .brand-tagline {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4em;
    color: var(--paper-fade);
  }
  .brand-tagline em {
    color: var(--violet-2);
    font-size: 1.05rem;
    letter-spacing: 0.005em;
  }
  .brand-sep {
    opacity: 0.4;
    color: var(--paper-fade);
    font-family: var(--font-mono);
  }

  .masthead-right {
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }

  .edition-text {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.05rem;
    font-family: var(--font-mono);
  }
  .edition-label {
    font-size: 0.58rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--paper-deepfade);
  }
  .edition-num {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--violet-2);
    letter-spacing: 0.02em;
    line-height: 1;
  }

  .stamp-wrap {
    display: inline-flex;
  }

  main {
    min-height: 60vh;
  }

  @media (max-width: 760px) {
    .stamp-wrap { display: none; }
    .masthead-right { gap: 0; }
  }

  @media (max-width: 600px) {
    .brand-logo { height: 22px; }
    .brand-tagline em { font-size: 0.95rem; }
    .brand { gap: 0.7rem; }
    .edition-num { font-size: 1rem; }
  }

  @media (max-width: 460px) {
    .brand-tagline { display: none; }
    .edition-text { display: none; }
  }
</style>

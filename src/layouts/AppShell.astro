---
/**
 * AppShell.astro — top-level layout for every Open Review page.
 *
 * Renders:
 *   1. Atmosphere layer    (.atmos + .stars + .grain — fixed, decorative)
 *   2. Masthead            (logo + edition badge)
 *   3. Slot                (page-specific content; chapter pages add
 *                           their own three-pane grid inside this slot)
 *   4. Colophon            (R9 + R10 + R7)
 *
 * Fonts (D9 Hybrid Scenario C): Fraunces variable + Inter variable +
 * JetBrains Mono are loaded from Google Fonts during Step 1.5.
 * Self-hosting the woff2 files is a Step 6 polish task before deploy
 * (R17 compliance).
 */
import '@styles/global.css';
import { SITE } from '@data/site';
import Colophon from '@components/Colophon.astro';

interface Props {
  title?: string;
  description?: string;
  /** Set false on pages where the CC-Zero attribution doesn't apply
   *  (Phase II waitlist, 404). */
  showAttribution?: boolean;
  /** Page-level OG image override. Defaults to the edition OG. */
  ogImage?: string;
}

const {
  title       = SITE.title,
  description = SITE.tagline,
  showAttribution = true,
  ogImage     = `${SITE.baseUrl}/og-${SITE.edition}.png`,
} = Astro.props;

const fullTitle = title === SITE.title ? title : `${title} — ${SITE.title}`;
const canonical = `${SITE.baseUrl}${Astro.url.pathname}`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0d0a18" />
    <meta name="referrer"    content="no-referrer" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph + Twitter -->
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonical} />
    <meta property="og:title"       content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImage} />
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />

    <!-- Favicon: violet glyph, inline SVG (no extra request, no CDN). -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><circle cx='16' cy='16' r='13' fill='none' stroke='%23a78bfa' stroke-width='1.4'/><circle cx='16' cy='16' r='3' fill='%23a78bfa'/></svg>" />

    <!-- Fonts: Cormorant Garamond (D10) + Inter + JetBrains Mono.
         Self-hosted in Step 6 (R17). -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500;1,600&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>

  <body>
    <div class="atmos" aria-hidden="true"></div>
    <div class="stars" aria-hidden="true"></div>
    <div class="grain" aria-hidden="true"></div>

    <div class="shell">
      <header class="masthead reveal" style="--reveal-delay: 0s">
        <a class="brand" href="/" aria-label="Pyragogy Open Review home">
          <img
            src="/logo-pyragogy.svg"
            alt="Pyragogy"
            class="brand-logo"
            width="220"
            height="40"
          />
          <span class="brand-tagline">
            <span class="brand-sep" aria-hidden="true">·</span>
            <em class="display-soft">Open Review</em>
          </span>
        </a>
        <span class="edition meta-xs">Edition {SITE.edition}</span>
      </header>

      <main id="main">
        <slot />
      </main>

      <Colophon attribution={showAttribution} />
    </div>
  </body>
</html>

<style>
  .masthead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.25rem clamp(1.5rem, 4vw, 3rem);
    border-bottom: 1px solid var(--rule);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    text-decoration: none;
    color: var(--paper-fade);
    transition: opacity 0.15s;
  }
  .brand:hover { opacity: 0.85; }

  /* Pyragogy logo — orange + dark navy bicolor, brand-fixed, R20 boundary
     exception (logo is brand asset, not page palette). Sized for 56px
     masthead; intrinsic ratio ~5.4:1. */
  .brand-logo {
    height: 22px;
    width: auto;
    display: block;
    flex-shrink: 0;
  }

  .brand-tagline {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4em;
    color: var(--paper-fade);
  }

  .brand-tagline em {
    color: var(--violet-2);
    font-size: 1rem;
    letter-spacing: 0.02em;
  }

  .brand-sep {
    opacity: 0.4;
    color: var(--paper-fade);
    font-family: var(--font-mono);
  }

  .edition {
    color: var(--violet-2);
  }

  main {
    min-height: 60vh;
  }

  @media (max-width: 600px) {
    .brand-logo { height: 18px; }
    .brand-tagline em { font-size: 0.9rem; }
    .brand { gap: 0.6rem; }
  }

  @media (max-width: 420px) {
    .brand-tagline { display: none; }
    .brand-logo { height: 20px; }
  }
</style>

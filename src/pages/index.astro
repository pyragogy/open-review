---
/**
 * index.astro — Open Review 2026 homepage.
 *
 * Composition (top → bottom):
 *
 *   1. Eyebrow                 "An interlude" — violet-3, mono caps
 *   2. Headline                Fraunces italic display, drop-cap "F",
 *                              "Peeragogy Handbook" rendered violet-3
 *   3. Asterism                ⁂ soft section break
 *   4. Standfirst              Fraunces soft italic, with em phrase
 *                              "No login. No quota. No surveillance."
 *   5. Meta-band               prose with inline mono numbers
 *   6. CTA                     "Begin reading →" with arrow translate
 *   7. Catalog strip           ten categories, 5×2 / 2×5 / 1col
 *
 * Each section reveals on load with staggered delay (R21 reduced-motion
 * compliant — see global.css .reveal).
 */
import AppShell from '@layouts/AppShell.astro';
import Asterism from '@components/Asterism.astro';
import CatalogStrip from '@components/CatalogStrip.astro';
import { SITE } from '@data/site';
import { CHAPTER_COUNT, CATEGORIES } from '@data/catalog';
---

<AppShell
  title={SITE.title}
  description={SITE.tagline}
>
  <article class="home">
    <p class="eyebrow reveal" style="--reveal-delay: 0.2s">An interlude</p>

    <h1 class="headline display reveal" style="--reveal-delay: 0.4s">
      <span class="dropcap" aria-hidden="true">F</span><span class="visually-hidden">F</span>ifty chapters of the
      <span class="emph">Peeragogy Handbook</span>,
      re-read by four AI agents.
    </h1>

    <div class="reveal" style="--reveal-delay: 0.7s">
      <Asterism margin={2.5} />
    </div>

    <p class="standfirst display-soft reveal" style="--reveal-delay: 0.9s">
      One static artifact. Generated once a year. Read at your own pace.
      <span class="em">No login. No quota. No surveillance.</span>
      The reading is the product.
    </p>

    <p class="meta-band reveal" style="--reveal-delay: 1.1s">
      <span class="mono-inline">{CHAPTER_COUNT}</span> chapters.
      <span class="mono-inline">{CATEGORIES.length}</span> categories.
      <span class="mono-inline">4</span> voices in conversation.
      Refreshed each January.
    </p>

    <p class="cta-row reveal" style="--reveal-delay: 1.1s">
      <a class="cta" href="/handbook/">
        Begin reading <span class="cta-arrow" aria-hidden="true">→</span>
      </a>
    </p>

    <section class="catalog-section reveal" style="--reveal-delay: 1.4s">
      <p class="meta-xs catalog-eyebrow">The catalog</p>
      <CatalogStrip />
    </section>
  </article>
</AppShell>

<style>
  .home {
    max-width: var(--shell-maxw);
    margin: 0 auto;
    padding: clamp(3rem, 8vh, 5.5rem) clamp(1.5rem, 5vw, 5rem);
  }

  /* ── Eyebrow ──────────────────────────────────────────────────────── */
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--violet-3);
    margin: 0 0 2rem;
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
  }
  .eyebrow::before {
    content: '';
    width: 28px;
    height: 1px;
    background: var(--violet-3);
    display: inline-block;
  }

  /* ── Headline ─────────────────────────────────────────────────────── */
  .headline {
    font-size: clamp(2.4rem, 6.4vw, 5.4rem);
    line-height: 1.05;
    color: var(--paper);
    margin: 0 0 0;
    text-wrap: balance;
    max-width: 22ch;
  }

  .emph {
    color: var(--violet-3);
    font-style: italic;
  }

  /* ── Drop cap: three lines tall, opsz 144 SOFT 0 ──────────────────── */
  .dropcap {
    float: left;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-variation-settings: "opsz" 144, "SOFT" 0, "wght" 400;
    color: var(--violet-3);
    font-size: 4.6em;
    line-height: 0.86;
    margin: 0.05em 0.06em 0 0;
    user-select: none;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* ── Standfirst ───────────────────────────────────────────────────── */
  .standfirst {
    font-size: clamp(1.15rem, 1.8vw, 1.4rem);
    line-height: 1.55;
    color: var(--paper-mute);
    max-width: 36ch;
    margin: 1.5rem 0 2.5rem;
  }

  .em {
    color: var(--violet-3);
    font-style: italic;
  }

  /* ── Meta-band ────────────────────────────────────────────────────── */
  .meta-band {
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--paper-fade);
    margin: 0 0 1.6rem;
    max-width: 32em;
  }

  /* ── CTA ──────────────────────────────────────────────────────────── */
  .cta-row {
    margin: 0 0 4rem;
  }

  .cta {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    color: var(--violet-3);
    text-decoration: none;
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 500;
    border-bottom: 1px solid var(--violet-7);
    padding-bottom: 2px;
    transition: color 0.2s, border-color 0.2s;
  }

  .cta:hover,
  .cta:focus-visible {
    color: var(--violet-2);
    border-bottom-color: var(--violet-3);
    outline: none;
  }

  .cta-arrow {
    display: inline-block;
    transition: transform 0.25s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .cta:hover .cta-arrow,
  .cta:focus-visible .cta-arrow {
    transform: translateX(4px);
  }

  /* ── Catalog ──────────────────────────────────────────────────────── */
  .catalog-section {
    margin-top: clamp(3rem, 8vh, 5rem);
  }

  .catalog-eyebrow {
    margin: 0 0 1.4rem;
    color: var(--mono-dim);
  }

  /* ── Mobile fine-tuning ───────────────────────────────────────────── */
  @media (max-width: 480px) {
    .dropcap {
      font-size: 4em;
    }
    .headline {
      font-size: 2.4rem;
    }
    .standfirst {
      font-size: 1.05rem;
    }
  }
</style>

---
/**
 * ProvenanceFooter.astro — required on every page (R9 + R10 + R7).
 *
 * Three responsibilities:
 *   - Provenance band:       generation date, engine version, next refresh
 *   - Obliqo CTA:            the single permitted use of amber #f59e0b
 *   - CC-Zero attribution:   Howard Rheingold et al., 2012, fork link
 *
 * Giscus is NOT rendered here — it lives only on chapter pages and is
 * mounted via a separate `<Giscus />` island (Step 6).
 */
import { SITE } from '@data/site';

interface Props {
  /** Show CC-Zero attribution block. Default true; set false on the
   *  Phase II waitlist page where chapter context isn't relevant. */
  attribution?: boolean;
}

const { attribution = true } = Astro.props;
const { edition, generatedDate, nextRefresh, engineVersion, obliqo, attribution: attr } = SITE;
---

<footer class="prov">
  <div class="prov-grid">
    <div class="prov-block prov-meta">
      <p class="meta-xs">
        Open Review {edition} · Generated {generatedDate} · Obliqo Engine {engineVersion}
      </p>
      <p class="meta-xs">
        Next refresh: {nextRefresh}
      </p>
    </div>

    <div class="prov-block prov-cta">
      <p class="meta-xs">{obliqo.label}</p>
      <a href={obliqo.url} class="obliqo-link" target="_blank" rel="noopener noreferrer">
        {obliqo.cta}
      </a>
    </div>

    {attribution && (
      <div class="prov-block prov-attr">
        <p class="meta-xs">Source</p>
        <p class="prov-attr-body">
          Based on <a href={attr.sourceHome} target="_blank" rel="noopener noreferrer">{attr.sourceLabel}</a>
          by {attr.sourceAuthors} ({attr.sourceYear}, {attr.sourceLicense}).
          Forked at <a href={attr.sourceRepo} target="_blank" rel="noopener noreferrer">pyragogy/legacy-peeragogy-handbook</a>.
        </p>
      </div>
    )}
  </div>
</footer>

<style>
  .prov {
    border-top: 1px solid var(--rule);
    padding: clamp(2rem, 5vh, 3rem) clamp(1.5rem, 4vw, 3rem);
    margin-top: clamp(3rem, 8vh, 5rem);
    color: var(--paper-mute);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    line-height: 1.6;
  }

  .prov-grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
    max-width: var(--shell-maxw);
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .prov-grid {
      grid-template-columns: 1fr 1fr 1.5fr;
    }
  }

  .prov-block { display: flex; flex-direction: column; gap: 0.4rem; }

  .meta-xs {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--paper-fade);
    margin: 0;
  }

  .prov-block a {
    color: var(--paper-mute);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    transition: color 0.15s, border-color 0.15s;
  }
  .prov-block a:hover,
  .prov-block a:focus-visible {
    color: var(--violet-pale);
    border-bottom-color: var(--violet);
    outline: none;
  }

  /* The Obliqo CTA is the only authorised use of amber on the page (R20). */
  .obliqo-link {
    color: var(--obliqo-cta) !important;
    border-bottom-color: rgba(245, 158, 11, 0.35) !important;
    font-weight: 500;
  }
  .obliqo-link:hover,
  .obliqo-link:focus-visible {
    color: #fbbf24 !important;
    border-bottom-color: var(--obliqo-cta) !important;
  }

  .prov-attr-body {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.85rem;
    color: var(--paper-mute);
    margin: 0;
    line-height: 1.55;
  }
</style>

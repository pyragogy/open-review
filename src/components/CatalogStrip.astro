---
/**
 * CatalogStrip.astro — ten categories, names in Fraunces italic,
 * counts in JetBrains Mono violet-3.
 *
 * Layout collapses by breakpoint:
 *   desktop ≥1024: 5 columns × 2 rows
 *   tablet 640–1023: 2 columns × 5 rows
 *   mobile <640: 1 column × 10 rows
 *
 * Border-right rules between cells collapse correctly per breakpoint:
 * cells in the rightmost column of the active grid drop their
 * right rule. Cells in the bottom row drop their bottom rule.
 *
 * Reusable on /handbook/index — the homepage uses it as a teaser,
 * the catalog index uses it as the main grid.
 */
import { CATEGORIES } from '@data/catalog';

interface Props {
  /** Optional href prefix override. Defaults to /handbook/<id>/. */
  hrefPrefix?: string;
}

const { hrefPrefix = '/handbook' } = Astro.props;
---

<nav class="catalog-strip" aria-label="Handbook categories">
  {CATEGORIES.map((cat) => (
    <a
      class="cat-cell"
      href={`${hrefPrefix}/${cat.id}/`}
      data-cat-id={cat.id}
    >
      <span class="cat-name display-soft">{cat.label}</span>
      <span class="cat-count meta-xs">{cat.chapters.length}</span>
    </a>
  ))}
</nav>

<style>
  .catalog-strip {
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
  }

  @media (min-width: 640px) {
    .catalog-strip {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .catalog-strip {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .cat-cell {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.4rem 1.4rem;
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    color: var(--paper-mute);
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .cat-cell:hover,
  .cat-cell:focus-visible {
    background: rgba(167, 139, 250, 0.05);
    color: var(--paper);
    outline: none;
  }

  .cat-cell:hover .cat-name,
  .cat-cell:focus-visible .cat-name {
    color: var(--violet-2);
  }

  .cat-name {
    font-size: 1.05rem;
    color: var(--paper-mute);
    line-height: 1.3;
    transition: color 0.2s ease;
  }

  .cat-count {
    color: var(--violet-3);
    flex-shrink: 0;
    font-feature-settings: 'tnum';
  }
</style>

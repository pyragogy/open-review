---
/**
 * Fleuron.astro — typographic ornament for section breaks.
 *
 * Five inline-SVG fleurons, all hand-drawn paths (no Unicode glyph
 * dependency, no proprietary font fallback). Each fleuron is a single
 * <svg> stroked in violet-2 with currentColor fallback.
 *
 *   variant="diamond"     — diamond rosette, three-lobed (default)
 *   variant="quatrefoil"  — four-petal rosette
 *   variant="aldine"      — Aldine leaf, italic stem
 *   variant="pilcrow"     — paragraph mark, decorative
 *   variant="asterism"    — three asterisks, classical
 *
 * The component renders only the glyph; combine with <hr class="rule-
 * centered"> in markup to get a full ornamented section break.
 */

interface Props {
  variant?: 'diamond' | 'quatrefoil' | 'aldine' | 'pilcrow' | 'asterism';
  size?: number;
  margin?: number;
}

const { variant = 'diamond', size = 22, margin = 2.4 } = Astro.props;
---

<div
  class={`fleuron fleuron--${variant}`}
  style={`--fleuron-size: ${size}px; --fleuron-margin: ${margin}rem;`}
  aria-hidden="true"
>
  {variant === 'diamond' && (
    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="0.9">
      <path d="M16 3 L29 16 L16 29 L3 16 Z" />
      <circle cx="16" cy="16" r="3.4" fill="currentColor" stroke="none" />
      <path d="M16 7 L16 25" stroke-dasharray="1 2" />
      <path d="M7 16 L25 16" stroke-dasharray="1 2" />
    </svg>
  )}

  {variant === 'quatrefoil' && (
    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="0.9">
      <path d="M16 4 C 22 4, 22 12, 16 12 C 22 12, 28 12, 28 18 C 28 24, 20 24, 16 20 C 16 24, 16 30, 10 30 C 4 30, 4 22, 10 18 C 4 18, 4 12, 10 12 C 16 12, 10 4, 16 4 Z"/>
      <circle cx="16" cy="16" r="2.4" fill="currentColor" stroke="none" />
    </svg>
  )}

  {variant === 'aldine' && (
    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="0.9">
      <path d="M4 16 Q 12 4, 16 16 Q 20 28, 28 16" />
      <path d="M16 16 L16 12" />
      <circle cx="16" cy="10.5" r="1.4" fill="currentColor" stroke="none" />
    </svg>
  )}

  {variant === 'pilcrow' && (
    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="0.9">
      <path d="M22 6 L22 26" />
      <path d="M16 6 L16 26" />
      <path d="M22 6 L12 6 C 8 6, 8 16, 12 16 L16 16" />
    </svg>
  )}

  {variant === 'asterism' && (
    <span class="asterism-glyphs">
      <span>*</span><span>*</span><span>*</span>
    </span>
  )}
</div>

<style>
  .fleuron {
    margin: var(--fleuron-margin) 0;
    text-align: center;
    color: var(--violet-2);
    line-height: 1;
  }

  .fleuron svg {
    width: var(--fleuron-size);
    height: var(--fleuron-size);
    display: inline-block;
    vertical-align: middle;
    opacity: 0.85;
  }

  /* Asterism uses real glyphs in Cormorant for editorial register. */
  .asterism-glyphs {
    display: inline-flex;
    gap: 0.35em;
    font-family: var(--font-display);
    font-style: italic;
    font-size: calc(var(--fleuron-size) * 0.95);
    color: var(--violet-2);
  }
  .asterism-glyphs span:nth-child(2) {
    transform: translateY(-0.18em);
    color: var(--violet-3);
  }
</style>

{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*":          ["src/*"],
      "@components/*":["src/components/*"],
      "@data/*":      ["src/data/*"],
      "@layouts/*":   ["src/layouts/*"],
      "@styles/*":    ["src/styles/*"]
    }
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "node_modules", "scripts"]
}
